# Telegram Bot Configuration
# Get your token from @BotFather
TELEGRAM_TOKEN=your_bot_token_here

# Database Configuration (SQLite only)
DATABASE_URL=sqlite+aiosqlite:////data/claude_bot.db

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# Application Settings
DEBUG=False

# Permission Cache Settings
# TTL in seconds (default: 300 = 5 minutes)
PERMISSION_CACHE_TTL=300

# Claude Authorization Bot Settings
# Base directory for data storage
DATA_DIR=/data
# Directory for Playwright browser sessions
SESSION_DIR=/data/sessions
# Directory for log files
LOG_DIR=/data/logs
# Directory for error screenshots
ERROR_DIR=/data/errors

# Playwright Settings
# Run browser in headless mode
PLAYWRIGHT_HEADLESS=true
# Operation timeout in milliseconds (default: 30s)
PLAYWRIGHT_TIMEOUT=30000

# Worker Settings
# Task polling interval in seconds
WORKER_POLL_INTERVAL=1.0
# Number of retry attempts for failed operations
WORKER_RETRY_ATTEMPTS=3
# Retry backoff delays in seconds (comma-separated)
WORKER_RETRY_BACKOFF=2,4,8
